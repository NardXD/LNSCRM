{
  "name": "windows-recorder",
  "version": "0.1.0",
  "private": true,
  "author": "ItsWorkPlaceCRM",
  "description": "Desktop screen recorder and upload queue client for ItsWorkPlace CRM",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "start:sync-only": "node dist/cli-sync.js",
    "electron:dev": "npm run build && electron .",
    "smoke:electron": "node scripts/electron-smoke.cjs",
    "bundle": "esbuild src/cli-sync.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/bundle.cjs",
    "package:win": "npm run bundle && pkg dist/bundle.cjs --targets node18-win-x64 --output dist/windows-recorder.exe",
    "build:release": "npm run installer:prepare",
    "pack:ui": "npm run build && electron-builder --win portable --publish never",
    "installer:prepare": "node scripts/run-installer-prepare.cjs"
  },
  "build": {
    "appId": "com.itsworkplace.recorder",
    "productName": "ItsWorkPlace Recorder",
    "directories": {
      "output": "installer-output-electron"
    },
    "files": [
      "dist/**/*.js",
      "public/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "ItsWorkPlaceRecorderUI.${ext}",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "typescript": "^5.9.3"
  }
}
